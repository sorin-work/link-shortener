{
  "name": "link-shortener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted short links with click analytics.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p server/tsconfig.build.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p server --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.9"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.6"
  }
}
