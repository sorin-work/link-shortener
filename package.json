{
  "name": "link-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted short links with click analytics.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "dev:web": "vite --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx server/src/scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@preact/preset-vite": "^2.10.2",
    "@testing-library/preact": "^3.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.9"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.7.5",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.13",
    "preact": "^10.28.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  }
}
